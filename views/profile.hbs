<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title> Profile | My SHF List </title>
	<link rel="stylesheet" type="text/css" media="all" href="/css/style.css">
</head>
<body>
    <div id="header_div" style="margin-bottom: 10px;">
        <div id="title_div" style="margin-right: 10px; margin-left: 25px;">
            <h2>My SHF List</h2>
        </div>
        <div id="nav_div">
            {{#if user}}
                <a href="/browse"><strong>Browse</strong></a>
                {{#if user.isAdmin}}
                     <a href="/figureForm"><strong >Create Entry</strong></a>
                {{else}}
                     <a href="/lists"><strong>My Lists</strong></a>
                {{/if}}
            {{else}}
                <a href="/browse"><strong>Browse</strong></a> 
                <a href="/login"><strong></strong>My Lists</strong></a> 
            {{/if}}
        </div>
        {{#if user}}
            <a href="/profile"><strong>Profile</strong></a> 
            <div style="margin-left: auto; margin-right: 25px">
                <form action="/logout" method="POST" style="display: inline;">
                    <button type="submit" style="background: none; border: none; padding: 0; font: inherit; cursor: pointer;"><strong>Logout</strong></button>
                </form>
            </div>
        {{else}}
            <div style="margin-left: auto; margin-right: 10px;">
                <a href="/login"><strong>Login</strong></a> 
                <a href="/signup"><strong></strong>Sign Up</strong></a>
            </div>
        {{/if}}
    </div>
	<div class="form_div">
        <p> Hi <strong>{{user.email}}</strong>, what would you like to do? </p>
        <div style="display: flex; flex-direction: column;">
            <button onclick="location.href='/editUser/changeEmail'" style="width: 100%; margin-bottom: 10px;"><p>Change Email</p></button>
            <button onclick="location.href='/editUser/changePassword'" style="width: 100%; margin-bottom: 10px;"><p>Change Password</p></button>
            <button onclick="location.href='/editUser/deleteUser'" style="width: 100%; margin-bottom: 10px;"><p>Delete Account</p></button>
        </div>
	</div>
</body>
</html>
