<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title> Log In | My SHF List </title>
	<link rel="stylesheet" type="text/css" media="all" href="/css/style.css">
</head>
<body>
    <div id="header_div">
        <div id="title_div" style="margin-left: 25px;">
            <h2>My SHF List</h2>
        </div>
    </div>
	<div class="form_div" style="margin-top: 20px;">
        <p> Log in to start managing your collection and wishlist! </p>

		<form class="main-form" action="/login" method="post">

            <div style="display: flex; flex-direction: column;">
                <label for="email"><p> Email </p></label>
			    <input id="email" name="email" type="email" placeholder="Enter your email" required>
            </div>

            <div style="display: flex; flex-direction: column;">
                <label for="password"><p> Password </p></label>
			    <input id="password" name="password" type="password" placeholder="Enter your password"  required>
            </div>

			<button type="submit"><p>Log In</p></button>

		</form>

		<p>New here? <a href="/signup">Create an account</a> | <a href="/">Back to home</a></p>
    </div>
</body>
</html>
